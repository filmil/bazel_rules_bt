module(
    name = "rules_bittorrent__integration",
    version = "0.0",
    compatibility_level = 0,
)

bazel_dep(name = "rules_bittorrent", version = "0.0")
local_path_override(module_name = "rules_bittorrent", path = "../")

bittorrent_file = use_repo_rule("@rules_bittorrent//:repo.bzl", "bittorrent_file")
bittorrent_file(
    name = "test_repo",
    uri = "@@//:ipfire-2.29-core196-aarch64.img.xz.torrent",
    file = "ipfire-2.29-core196-aarch64.img.xz",
    integrity = "sha256-F7CxVlOfx6DiscjCmt44qCLi+bX6RgjWIav0iZwCpEQ=",
    quiet = False,
)

bittorrent_archive = use_repo_rule("@rules_bittorrent//:repo.bzl", "bittorrent_archive")
bittorrent_archive(
    name = "test_repo_archive",
    uri = "@@//:audacity-sources-3.7.4.tar.gz.torrent",
    file = "audacity-sources-3.7.4.tar.gz",
    strip_prefix = "audacity-sources-3.7.4",
    # The same hash as the GitHub release asset audacity-sources-3.7.4.tar.gz.
    integrity = "sha256-ayzQEQjpyXxAEFGQm74ONLvFQgqI60PeHY3rlxXu/tk=",
    quiet = False,
    build_file_content = """#
filegroup(
    name = "file",
    srcs = [
        "{name}",
    ],
)
exports_files([
    "{name}",
])
""",
)

# The same torrent with a wrong integrity. Fetching this repository must
# fail; CI checks that it does. Nothing builds it otherwise, and Bazel does
# not fetch a repository that nothing uses.
bittorrent_file(
    name = "test_repo_wrong_integrity",
    uri = "@@//:audacity-sources-3.7.4.tar.gz.torrent",
    file = "audacity-sources-3.7.4.tar.gz",
    integrity = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
)
