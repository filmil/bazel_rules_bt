load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
#load("@rules_pkg//pkg/private/tar:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

gazelle_binary(
    name = "gazelle_bin",
    languages = DEFAULT_LANGUAGES + [
        "@bazel_skylib_gazelle_plugin//bzl",
    ],
)

bzl_library(
    name = "repo",
    srcs = ["repo.bzl"],
)


# Renders the public Starlark API of repo.bzl into docs/repo.md, and checks
# the rendered file into the source tree.
#
# `bazel test //...` runs docs_test, which fails when docs/repo.md is stale.
# `bazel run //:docs` rewrites it.
stardoc(
    name = "repo_docs",
    out = "repo.md.generated",
    input = "repo.bzl",
    deps = [":repo"],
)

write_source_files(
    name = "docs",
    files = {"docs/repo.md": ":repo.md.generated"},
)
